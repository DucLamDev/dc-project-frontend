    "subtitle": "Practical questions",
    "items": [
      {
        "question": "Do we need two outfits?",
        "answer": "No. One outfit in the wedding palette works for the whole day."
      },
      {
        "question": "Can we offer a physical gift?",
        "answer": "The couple prefers a virtual envelope. The Revolut link works even without an account."
      },
      {
        "question": "Are there hotel discounts?",
        "answer": "No, the list is only a helpful suggestion. You may choose any hotel or Airbnb."
      },
      {
        "question": "Are children planned for?",
        "answer": "A children's room is available, without childcare service."
      },
      {
        "question": "Can we wait at the reception venue from 11 AM to 4 PM?",
